# Application
# 32-byte key, hex-encoded (64 chars). Generate with: openssl rand -hex 32
# Used for AES-256-GCM credential encryption, phone hashing, signed onboarding
# tokens, and session cookies.
APP_ENCRYPTION_KEY=
# Shared secret the deployment uses to call its own eve session routes.
# Required by the unstick-conversations watchdog, which cancels a wedged
# session so a conversation cannot go silent indefinitely. Minimum 32 chars.
# Generate with: openssl rand -hex 32
BELLE_INTERNAL_TOKEN=
# Public origin of this deployment, e.g. https://belle.help
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The phone number users text to reach Belle, shown on the landing page.
# Leave unset until the Linq line is provisioned — the site renders an honest
# "coming soon" state instead of a fake number.
NEXT_PUBLIC_BELLE_PHONE_NUMBER=

# Linq (iMessage/RCS/SMS relay) — dashboard.linqapp.com/api-tooling
LINQ_API_KEY=
LINQ_API_BASE_URL=https://api.linqapp.com
# Standard-Webhooks signing secret (whsec_...) returned once when creating the
# webhook subscription pointed at <APP_URL>/eve/v1/linq?version=2026-02-03
LINQ_WEBHOOK_SECRET=

# GitHub via Vercel Connect (no App private key / webhook secret needed)
# Connector UID from `vercel connect create github --triggers`
VERCEL_CONNECT_GITHUB_UID=github/belle
# The managed GitHub App's bot login (for @mention dispatch)
GITHUB_BOT_NAME=belle-agent
# Public install URL of the managed GitHub App, shown during onboarding
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=
# Local-dev fallback ONLY when Connect is unavailable (classic/fine-grained
# token). Never set in production.
GITHUB_TOKEN=

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Shared secret the agent runtime presents (header x-belle-internal) to start
# durable deferred-action workflow runs at /api/workflows/deferred. Generate
# with: openssl rand -hex 32
# Leave unset to disable the durable fast path — the existing 5-minute
# reconcile-github-events cron sweep still handles scheduledActions as a
# fallback, just with up to 5 minutes of latency.
INTERNAL_TRIGGER_SECRET=

# OpenAI fallback (managed mode when a user has not configured BYOK)
OPENAI_API_KEY=

# Optional
# Vercel AI Gateway key for LOCAL development; production uses Vercel OIDC.
AI_GATEWAY_API_KEY=

# Observability (optional OTLP export target; Vercel Observability is default)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Admin (invite-only approval queue at /admin)
# Only used for first-run seeding via `npm run seed:admin` or POST
# /api/admin/seed; the admin is forced to change the password at first
# sign-in, so it's safe to leave this in a committed .env for local dev.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Optional — enables POST /api/admin/seed as a serverless fallback for
# deploys where running scripts/seed-admin.mjs isn't convenient. Leave
# unset to disable that endpoint entirely (it 404s when unset).
ADMIN_SEED_TOKEN=

# Redis (durable Chat SDK state: thread subscriptions, locks, history cache)
# Without it the channel falls back to in-memory state, which resets on every
# cold start — fine for local dev, not for production.
REDIS_URL=
